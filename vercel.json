{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://SEU_BACKEND/api/:path*"
    },
    {
      "source": "/events",
      "destination": "https://SEU_BACKEND/events"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
