# Copie para .env no servidor e preencha os segredos.
DOMAIN=livemonitortk.com.br
POSTGRES_DB=tiktok_live_monitor
POSTGRES_USER=tlm
POSTGRES_PASSWORD=troque-por-uma-senha-longa
# O Compose deriva DATABASE_URL dos campos POSTGRES_* acima.
# Use senha hexadecimal (openssl rand -hex 24) para não exigir escape na URL.
# Defina DATABASE_URL somente se precisar sobrescrever a conexão.

# Auth: login, usuários e profiles continuam no projeto Supabase hospedado.
# Só os dados operacionais ficam no Postgres do compose.
AUTH_ENABLED=1
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
TRUSTED_PROXIES=172.16.0.0/12

# E-mail opcional usado por cadastro e recuperação de senha.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
MAIL_FROM=Equipe TikTok Live Monitor <no-reply@livemonitortk.com.br>
MAIL_SUBJECT=Liberação do acesso ao TikTok Live Monitor
MAIL_RESET_SUBJECT=Redefinição de senha — TikTok Live Monitor
PAYMENT_PIX_KEY=
PAYMENT_LINK=
PAYMENT_PRICE=20,00

SKIP_TESTS=1

# ── Fila PIX (opcional) ─────────────────────────────────────────────────────
# Sem este bloco a Fila PIX fica desligada e o deploy sobe só postgres,
# backend, frontend e nginx. Modos (ver PRODUCAO.md, "Fila PIX"):
#   MinIO próprio: COMPOSE_PROFILES=pix,pix-minio e MINIO_ENDPOINT=minio:9000
#   MinIO externo: COMPOSE_PROFILES=pix, MINIO_EXTERNAL_NETWORK, MINIO_ENDPOINT
#                  e -f deploy/compose.minio-externo.yml em todo comando
# COMPOSE_PROFILES=pix,pix-minio
# WAHA_ENABLED=1
# WAHA_API_KEY=troque-por-uma-chave-longa
# WAHA_WEBHOOK_SECRET=troque-por-um-segredo-longo
# GOWS não roda Chromium (a imagem :latest/WEBJS usa 300–600 MB de RAM).
# WAHA_IMAGE=devlikeapro/waha:gows-2026.9.1
# WAHA_ENGINE=GOWS
# WAHA_MEM_LIMIT=384m

# MinIO próprio: estas chaves viram o root do container minio.
# MinIO externo: chave de um usuário restrito ao bucket (nunca o root).
# MINIO_ENDPOINT=minio:9000
# MINIO_EXTERNAL_NETWORK=
# MINIO_ACCESS_KEY=troque-por-um-access-key
# MINIO_SECRET_KEY=troque-por-uma-secret-key
# MINIO_BUCKET=tlm-pix-media
# O repositório minio/minio saiu do Docker Hub; o default é bitnamilegacy/minio
# (mesma API S3), com tag pinada. Só usado no profile pix-minio.
# MINIO_IMAGE=bitnamilegacy/minio:2025.7.23
# OCR dos comprovantes JPG (filtro de valores da Fila PIX). Já vem na imagem
# do backend (tesseract-ocr + tesseract-ocr-por).
TESSERACT_BIN=tesseract

# Teto global de lives simultâneas (todas as organizações). O limite por
# organização é configurado na administração.
# MAX_MONITORS=20
