# Copie para .env e ajuste: cp .env.example .env

# ── Servidor ────────────────────────────────────────────────────────────────
# Backend (API Go): PORT/HOST. Frontend (nginx): FRONTEND_PORT.
PORT=3001
HOST=0.0.0.0
FRONTEND_PORT=8080

# Origens liberadas para CORS (vírgula) — só quando o frontend roda em outra
# origem (ex.: Vercel ou dev local). Vazio = sem CORS (mesma origem via proxy).
# Ex.: CORS_ALLOWED_ORIGINS=http://localhost:3000,https://meu-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Teto de conexões SSE simultâneas (padrão: 10000). Acima do limite, novos
# clientes recebem 503 (podem reconectar); os existentes continuam servidos.
# SSE_MAX_CLIENTS=10000

# ── PostgreSQL — obrigatório ─────────────────────────────────────────────────
# Estes valores sobem o Postgres local no Docker Compose. Em produção,
# substitua DATABASE_URL pela conexão do Supabase (pooler na Vercel).
POSTGRES_DB=tiktok_live_monitor
POSTGRES_USER=tlm
POSTGRES_PASSWORD=troque-esta-senha-local
DATABASE_URL=postgres://tlm:troque-esta-senha-local@postgres:5432/tiktok_live_monitor?sslmode=disable

# Tamanho do pool de conexões do banco (padrão: 20). Aumente se houver
# muitos clientes fazendo requisições REST simultâneas.
# DB_MAX_CONNS=20

# ── Autenticação Supabase ───────────────────────────────────────────────────
# AUTH_ENABLED=0 desliga login (acesso livre — útil para smoke test rápido)
AUTH_ENABLED=1
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Opcional: quando vazio, o backend valida tokens pela API Auth do Supabase.
# Preencha apenas para validação local HS256 com o segredo JWT legado.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Validação do JWT: aud/iss esperados nos access tokens.
# Padrões: aud="authenticated"; iss="${SUPABASE_URL}/auth/v1".
# SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_ISSUER=https://SEU_PROJETO.supabase.co/auth/v1

# Bloqueio por tentativas de login
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Proxy reverso confiável (IPs/CIDRs separados por vírgula). Apenas requisições
# vindas desses endereços têm X-Forwarded-For/X-Real-IP honrados no lockout.
# Vazio = ignora os headers (recomendado sem proxy, ou quando o proxy está no host).
# TRUSTED_PROXIES=172.17.0.0/16,10.0.0.2

# Cores do tema (login + app)
AUTH_THEME_PINK=#fe2c55
AUTH_THEME_CYAN=#25f4ee
AUTH_THEME_BG=#0b0d12

# ── E-mail transacional (boas-vindas ao cadastrar) ─────────────────────────
# Sem SMTP_HOST o mailer fica desabilitado e nada é enviado (sem erro).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | implicit | none   (default: starttls)
SMTP_TLS_MODE=starttls
# 1 = pular verificação TLS (apenas p/ SMTP self-signed em dev)
# SMTP_INSECURE_SKIP_VERIFY=0
MAIL_FROM=Equipe TikTok Live Monitor <no-reply@tiktoklivemonitor.com>
MAIL_SUBJECT=Liberação do acesso ao TikTok Live Monitor

# ── Pagamento (usado no corpo do e-mail) ────────────────────────────────────
# Prioridade da linha "Pagamento:": PAYMENT_LINK > PAYMENT_PIX_KEY > placeholder.
PAYMENT_PIX_KEY=
PAYMENT_LINK=
PAYMENT_PRICE=20,00

# ── Build Docker ────────────────────────────────────────────────────────────
# 1 = pula go test no build (mais rápido na Pi / cross-build)
SKIP_TESTS=1
