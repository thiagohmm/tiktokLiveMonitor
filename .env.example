# Copie para .env e ajuste: cp .env.example .env

# ── Servidor ────────────────────────────────────────────────────────────────
# Backend (API Go): PORT/HOST. Frontend (nginx): FRONTEND_PORT.
PORT=3001
HOST=0.0.0.0
FRONTEND_PORT=8080

# Origens liberadas para CORS (vírgula) — só quando o frontend roda em outra
# origem (ex.: dev server local). Vazio = sem CORS (mesma origem via proxy).
# Ex.: CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Teto de conexões SSE simultâneas (padrão: 10000). Acima do limite, novos
# clientes recebem 503 (podem reconectar); os existentes continuam servidos.
# SSE_MAX_CLIENTS=10000

# ── PostgreSQL — obrigatório ─────────────────────────────────────────────────
# Estes valores sobem o Postgres do Docker Compose (serviço postgres). Em
# produção (VPS) o banco também é o Postgres do compose: use
# .env.production.example, que deriva DATABASE_URL de POSTGRES_*.
# O schema é criado/migrado pelo backend no boot.
POSTGRES_DB=tiktok_live_monitor
POSTGRES_USER=tlm
POSTGRES_PASSWORD=troque-esta-senha-local
DATABASE_URL=postgres://tlm:troque-esta-senha-local@postgres:5432/tiktok_live_monitor?sslmode=disable

# Tamanho do pool de conexões do banco (padrão: 20). Aumente se houver
# muitos clientes fazendo requisições REST simultâneas.
# DB_MAX_CONNS=20

# ── Autenticação Supabase ───────────────────────────────────────────────────
# Login, usuários e profiles continuam no projeto Supabase hospedado.
# Sem SUPABASE_URL ou SUPABASE_ANON_KEY o backend NÃO sobe (fail-closed).
# AUTH_ENABLED=0 desliga login explicitamente (acesso livre na organização
# padrão — só para dev local / smoke test).
AUTH_ENABLED=1
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Opcional: quando vazio, o backend valida tokens pela API Auth do Supabase.
# Preencha apenas para validação local HS256 com o segredo JWT legado.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Origem pública do frontend, usada no redirect_to do link de redefinição de
# senha (o Supabase redireciona para SITE_URL/reset-password.html). Ex.:
# SITE_URL=https://livemonitortk.com.br (em produção o compose deriva de DOMAIN)
# Sem SITE_URL, o POST /api/auth/recover responde 503 (falha de configuração).
# A URL final (com /reset-password.html) precisa estar na allowlist de
# Redirect URLs do Supabase (Authentication > URL Configuration).
SITE_URL=

# Validação do JWT: aud/iss esperados nos access tokens.
# Padrões: aud="authenticated"; iss="${SUPABASE_URL}/auth/v1".
# SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_ISSUER=https://SEU_PROJETO.supabase.co/auth/v1

# Bloqueio por tentativas de login
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Proxy reverso confiável (IPs/CIDRs separados por vírgula). Apenas requisições
# vindas desses endereços têm X-Forwarded-For/X-Real-IP honrados no lockout.
# Vazio = ignora os headers (recomendado sem proxy, ou quando o proxy está no host).
# TRUSTED_PROXIES=172.17.0.0/16,10.0.0.2

# Cores do tema (login + app)
AUTH_THEME_PINK=#fe2c55
AUTH_THEME_CYAN=#25f4ee
AUTH_THEME_BG=#0b0d12

# ── E-mail transacional (boas-vindas e redefinição de senha) ────────────────────
# Sem RESEND_API_KEY e SMTP_HOST o mailer fica desabilitado e nada é enviado.
# Preferível em produção: Resend via HTTPS (alguns provedores de VPS bloqueiam SMTP).
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | implicit | none   (default: starttls)
SMTP_TLS_MODE=starttls
# 1 = pular verificação TLS (apenas p/ SMTP self-signed em dev)
# SMTP_INSECURE_SKIP_VERIFY=0
MAIL_FROM=Equipe TikTok Live Monitor <no-reply@tiktoklivemonitor.com>
MAIL_SUBJECT=Liberação do acesso ao TikTok Live Monitor
# Assunto do e-mail de redefinição de senha (opcional — há padrão).
# MAIL_RESET_SUBJECT=Redefinição de senha — TikTok Live Monitor

# ── Pagamento (usado no corpo do e-mail) ────────────────────────────────────
# Prioridade da linha "Pagamento:": PAYMENT_LINK > PAYMENT_PIX_KEY > placeholder.
PAYMENT_PIX_KEY=
PAYMENT_LINK=
PAYMENT_PRICE=20,00

# ── Build Docker ────────────────────────────────────────────────────────────
# 1 = pula go test no build (mais rápido na Pi / cross-build)
SKIP_TESTS=1

# ── Fila PIX — WhatsApp/WAHA ────────────────────────────────────────────────
# WAHA_ENABLED=0 desliga a Fila PIX sem derrubar o monitor de lives.
WAHA_ENABLED=1
WAHA_URL=http://waha:3000
# Chave global do container WAHA (header X-Api-Key). Troque em produção.
WAHA_API_KEY=tlm-local-waha-key
# Segredo do HMAC-SHA512 do webhook (WHATSAPP_HOOK_HMAC_KEY no WAHA).
WAHA_WEBHOOK_SECRET=tlm-local-waha-secret
# Imagem WAHA: depende da arquitetura (ex.: gows-arm-2026.9.1 no Mac Apple
# Silicon; tag amd64 no VPS).
WAHA_IMAGE=devlikeapro/waha:latest

# ── Fila PIX — MinIO (comprovantes) ─────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tlm-local-minio
MINIO_SECRET_KEY=tlm-local-minio-secret
MINIO_BUCKET=tlm-pix-media
MINIO_USE_SSL=0
PIX_MEDIA_MAX_BYTES=16777216
# O repositório minio/minio saiu do Docker Hub; o default usa o espelho
# bitnamilegacy/minio (mesma API S3, porta 9000). Pin uma tag em produção.
MINIO_IMAGE=bitnamilegacy/minio:2025.7.23
# OCR dos comprovantes JPG (filtro de valores da Fila PIX). O binário já vem
# na imagem do backend (tesseract-ocr + tesseract-ocr-por); mude aqui só se
# precisar de outro executável.
TESSERACT_BIN=tesseract

# ── Multi-tenant ────────────────────────────────────────────────────────────
# Teto global de lives monitoradas ao mesmo tempo (todas as organizações).
# O limite de cada organização é definido na administração (max_lives).
# MAX_MONITORS=20
